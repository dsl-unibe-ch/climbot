# Microsoft Entra ID
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_API_SCOPE=api://your-client-id/ClimeBot.Access
AZURE_REDIRECT_URI=https://your-deployment-url

# URL of the FastAPI container/service
BACKEND_URL=http://backend:8000

# Streamlit
STREAMLIT_PORT=8501

# Comma-separated list of allowed UPNs/emails; leave empty to allow all authenticated users
ALLOWED_USERS=

# Contact shown in the access-denied screen (name or mailto link)
ADMIN_CONTACT=[Admin](mailto:admin@your-org.com)
