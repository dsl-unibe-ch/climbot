# ──────────────────────────────────────────
# Microsoft Entra ID
# ──────────────────────────────────────────
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here
# Must match the Redirect URI registered in Microsoft Entra ID
AZURE_REDIRECT_URI=http://localhost:8501
# Full scope URI — must match the scope name you chose in Entra ID "Expose an API"
AZURE_API_SCOPE=api://YOUR_CLIENT_ID/ClimeBot.Access

# ──────────────────────────────────────────
# OpenAI — or any OpenAI-compatible endpoint (e.g. GPUStack)
# ──────────────────────────────────────────
OPENAI_API_KEY=your-api-key
# Leave blank to use openai.com; set to your GPUStack / local LLM base URL
OPENAI_BASE_URL=https://gpustack.unibe.ch/v1
OPENAI_MODEL=minimax-m2.7
# Vision model for image description during ingestion; must be multimodal
# Leave blank to reuse OPENAI_MODEL (only works if it supports vision)
OPENAI_VISION_MODEL=qwen3-vl-8b-instruct
# Must be an embedding model available at the same endpoint
OPENAI_EMBEDDING_MODEL=qwen3-embedding-0.6b
# Output dimension of the embedding model (qwen3-embedding-0.6b = 1024)
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.3
# reasoning models (e.g. minimax-m2.7) spend think-tokens before the answer;
# set high enough to cover think block + full response
LLM_MAX_TOKENS=32000
LLM_TOP_P=1.0

# ──────────────────────────────────────────
# Qdrant vector database
# Use "qdrant" (service name) for Docker, "localhost" for bare-metal dev
# ──────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=climate_docs
QDRANT_COLLECTION_IMAGES=climate_images

# ──────────────────────────────────────────
# Backend (FastAPI)
# ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:8501

# ──────────────────────────────────────────
# Frontend (Streamlit)
# Use "http://backend:8000" inside Docker, "http://localhost:8000" for local dev
# ──────────────────────────────────────────
STREAMLIT_PORT=8501
BACKEND_URL=http://backend:8000

# ──────────────────────────────────────────
# Document ingestion
# ──────────────────────────────────────────
DATA_DIR=/app/data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ──────────────────────────────────────────
# Scrapy (local use — not part of Docker)
# ──────────────────────────────────────────
SCRAPY_OUTPUT_DIR=./data
SCRAPY_DEPTH_LIMIT=3
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_DOWNLOAD_DELAY=1.5
# Comma-separated; leave blank to use defaults
SCRAPY_TARGET_DOMAINS=
SCRAPY_START_URLS=
