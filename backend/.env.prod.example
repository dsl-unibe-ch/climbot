# Copy this file to backend/.env.prod and fill in every placeholder before deploying.

# ──────────────────────────────────────────
# Microsoft Entra ID
# ──────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=https://your-deployment-url
AZURE_API_SCOPE=api://your-client-id/ClimeBot.Access

# ──────────────────────────────────────────
# OpenAI-compatible LLM endpoint
# ──────────────────────────────────────────
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-llm-endpoint/v1
OPENAI_MODEL=your-chat-model
OPENAI_VISION_MODEL=your-vision-model
OPENAI_EMBEDDING_MODEL=your-embedding-model
# Must match the output dimension of the embedding model
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=16000
LLM_TOP_P=1.0

# ──────────────────────────────────────────
# Qdrant vector database
# QDRANT_HOST=qdrant uses the Docker Compose service name
# ──────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=climate_docs
QDRANT_COLLECTION_IMAGES=climate_images

# ──────────────────────────────────────────
# Backend (FastAPI)
# ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://your-deployment-url
DATA_DIR=/app/data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
