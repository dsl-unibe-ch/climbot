# Microsoft Entra ID
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:8501
AZURE_API_SCOPE=api://your-client-id/ClimeBot.Access

# OpenAI-compatible LLM endpoint
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://gpustack.unibe.ch/v1
OPENAI_MODEL=minimax-m2.7
OPENAI_VISION_MODEL=qwen3-vl-8b-instruct
OPENAI_EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=16000
LLM_TOP_P=1.0

# Qdrant vector database service
# Docker: the compose service name "qdrant" (set automatically for the backend container)
# Bare-metal ETL/dev: "localhost" reaches the loopback-published service port
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=climate_docs
QDRANT_COLLECTION_IMAGES=climate_images

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:8501

# Ingestion
DATA_DIR=/app/data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
